; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Coven (WWDC23 Port)"
config/tags=PackedStringArray("c#", "port")
run/main_scene="res://Scenes/game.tscn"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
config/icon="res://Assets/appIcon.png"

[autoload]

DanmakuPatterns="*res://Global/DanmakuPatterns.cs"

[display]

window/size/viewport_width=720
window/size/viewport_height=960
window/size/resizable=false

[dotnet]

project/assembly_name="Coven (WWDC23 Port)"

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="player_bullet"
2d_physics/layer_3="enemy"
2d_physics/layer_4="enemy_bullet"
